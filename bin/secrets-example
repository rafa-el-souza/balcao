#!/usr/bin/env ruby
# Prints a fresh set of the generated runtime secrets as KEY=value lines, for
# the deploying account to append to its destination's env file (design §8,
# threat model SR-25). Values come from SecureRandom and use letters and digits
# only, so the file reads the same through a shell and through dotenv.
#
# A name already set in the environment is skipped: run it with the env file
# loaded and append the output, and only missing secrets are added. Rotating
# a key that is in use (the encryption keys above all, which would make stored
# data unreadable) stays a deliberate edit of the env file, never a side effect.
require "securerandom"

GENERATED = {
  "SECRET_KEY_BASE" => -> { SecureRandom.alphanumeric(128) },
  "POSTGRES_PASSWORD" => -> { SecureRandom.alphanumeric(40) },
  # bin/rails db:encryption:init generates 32 alphanumeric characters for each.
  "ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY" => -> { SecureRandom.alphanumeric(32) },
  "ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY" => -> { SecureRandom.alphanumeric(32) },
  "ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT" => -> { SecureRandom.alphanumeric(32) },
  # The pepper of sha256(pepper || bsuid), the WhatsApp visitor identity (FR-19).
  "IDENTITY_PEPPER" => -> { SecureRandom.alphanumeric(64) }
}.freeze

missing = GENERATED.reject { |name, _| ENV.fetch(name, "").strip.length.positive? }
skipped = GENERATED.keys - missing.keys

puts "# bin/secrets-example, #{Time.now.utc.strftime("%Y-%m-%d")}"
puts "# already set, kept: #{skipped.join(", ")}" if skipped.any?
missing.each { |name, generate| puts "#{name}=#{generate.call}" }
