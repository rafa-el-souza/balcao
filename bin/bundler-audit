#!/usr/bin/env ruby
require_relative "../config/boot"
require "bundler/audit/cli"

# Threat model SR-27: on the Ruby side CI fails on known vulnerabilities above
# low. bundler-audit has no threshold option, so only its exit decision is
# narrowed here: every advisory is still printed, and the run fails on an
# insecure gem source or on an advisory rated medium or above, or not rated at
# all. Review finding F3, pull request #1.
module FailAboveLow
  PASSING = %i[none low].freeze
  LEVELS = %i[none low medium high critical].freeze

  def vulnerable?
    results.any? do |result|
      !result.is_a?(Bundler::Audit::Results::UnpatchedGem) || !PASSING.include?(FailAboveLow.criticality(result.advisory))
    end
  end

  # bundler-audit 0.9.3 rates by CVSS v3, else v2, and never reads v4; the v4
  # score is rated here with the v3 bands (review finding R4, pull request
  # #1). "Above low" is the higher of the two ratings, so an advisory low in
  # v3 and medium in v4 fails, and one with no score at all is rated nil,
  # which fails too (threat model SR-27, the owner's word of 2026-11-15).
  def self.criticality(advisory)
    ratings = [ advisory.criticality, v4(advisory) ].compact
    ratings.max_by { |rating| LEVELS.index(rating) }
  end

  def self.v4(advisory)
    case YAML.safe_load_file(advisory.path, permitted_classes: [ Date ])["cvss_v4"]
    when 0.0 then :none
    when 0.1..3.9 then :low
    when 4.0..6.9 then :medium
    when 7.0..8.9 then :high
    when 9.0..10.0 then :critical
    end
  end
end
Bundler::Audit::Report.prepend(FailAboveLow)

# When only low advisories are found, the stock text report lists them and
# then says "No vulnerabilities found"; say what happened instead (finding
# V2 of the verifier, pull request #1).
require "bundler/audit/cli/formats/text"
module ReportLowAdvisories
  def print_report(report, output = $stdout)
    return super if report.vulnerable? || report.results.empty?

    original_stdout = $stdout
    $stdout = output
    report.each { |result| print_advisory(result.gem, result.advisory) }
    say "Low advisories only: listed above; CI fails above low (threat model SR-27).", :yellow
  ensure
    $stdout = original_stdout if original_stdout
  end
end
Bundler::Audit::CLI::Formats::Text.prepend(ReportLowAdvisories)

ARGV.concat %w[ --config config/bundler-audit.yml ] if ARGV.empty? || ARGV.include?("check")
Bundler::Audit::CLI.start
