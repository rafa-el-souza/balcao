#!/usr/bin/env ruby
# Deploys the rehearsal destination, and nothing else (ADR-0011, threat model
# SR-38). Production is deployed by a human from the operator account, with
# the pinned global kamal invoked directly after the deploy-path review; this
# script refuses every other invocation before kamal runs.
#
#   bin/deploy -d ensaio
#
# The deploying shell exports ENSAIO_HOST, ENSAIO_SSH_KEY and ENSAIO_SSH_CONFIG
# (read by config/deploy.ensaio.yml) and the secrets that .kamal/secrets.ensaio
# references. kamal setup runs every time: on a fresh host it boots the
# accessories, and on a running one it skips them and deploys, as kamal deploy
# would. The local registry is removed afterwards, whatever happened, and its
# anonymous volume with it.

DESTINATION = "ensaio".freeze
REHEARSAL_VARIABLES = %w[ENSAIO_HOST ENSAIO_SSH_KEY ENSAIO_SSH_CONFIG].freeze

def refuse(message)
  warn "bin/deploy: #{message}"
  exit 1
end

unless ARGV == [ "-d", DESTINATION ]
  refuse "the only accepted invocation is `bin/deploy -d #{DESTINATION}` (threat model SR-38)."
end

blank = REHEARSAL_VARIABLES.select { |name| ENV.fetch(name, "").strip.empty? }
refuse "#{blank.join(", ")} must be set in the deploying shell." if blank.any?

status = IO.popen([ "git", "status", "--porcelain" ], err: File::NULL, &:read)
refuse "git status failed, so the working tree cannot be checked." unless $?.success?
unless status.strip.empty?
  refuse "the working tree has uncommitted changes; kamal builds the committed HEAD, so commit or stash them first."
end

# The pinned kamal-proxy (threat model SR-27). Kamal runs it by its tag, and
# Docker asks the registry for a tag the host lacks (a fresh host, or one whose
# proxy image was removed), where a tag can be pushed again. So every deploy
# first puts the image on the host by the digest written beside the tag in
# config/deploy.yml, under that tag, and Docker then runs the tag it holds
# (review findings C1 and R1 of pull request #21). The digest is tied to the
# tag by hand, so the image's own version label, which kamal-proxy's releases
# set to their tag from v0.10, must name the pinned tag before the image takes
# it. A label that is no release tag passes: before v0.10 the image only
# carries its Ubuntu base's (v0.9.2 says 24.04), and v0.9.2 is the way back
# (review finding R2).
pin = File.read(File.expand_path("../config/deploy.yml", __dir__))
  .match(%r{^\s*version: (v\d+\.\d+\.\d+) # (basecamp/kamal-proxy@sha256:\h{64})$})
refuse "config/deploy.yml pins no kamal-proxy version with its digest beside it (threat model SR-27)." unless pin
proxy_version, proxy_digest = pin.captures
release_label = %({{index .Config.Labels "org.opencontainers.image.version"}})
put_proxy = [
  "(docker image inspect #{proxy_digest} > /dev/null 2>&1 || docker pull #{proxy_digest})",
  %(release=$(docker image inspect #{proxy_digest} --format '#{release_label}')),
  %(case "$release" in v[0-9]*\) [ "$release" = #{proxy_version} ] || ) +
    %({ echo "kamal-proxy: #{proxy_digest} is release $release, not #{proxy_version}" >&2; false; };; esac),
  "docker tag #{proxy_digest} basecamp/kamal-proxy:#{proxy_version}"
].join(" && ")

def kamal(*args)
  puts "== kamal #{args.join(" ")}"
  system("kamal", *args)
end

# Kamal 2.12 runs its local registry from registry:3, whose image declares a
# volume for /var/lib/registry, and removes the container without it, so each
# deploy would leave an anonymous volume of about 158 MB behind (the MVP
# close). Its name is read while the container exists; a named volume, or a
# volume mounted anywhere else, is never this one.
REGISTRY_CONTAINER = "kamal-docker-registry".freeze
REGISTRY_DATA = "/var/lib/registry".freeze

def registry_volumes
  mounts = %({{range .Mounts}}{{if eq .Type "volume"}}{{println .Name .Destination}}{{end}}{{end}})
  out = IO.popen([ "docker", "container", "inspect", "--format", mounts, REGISTRY_CONTAINER ], err: File::NULL, &:read)
  return [] unless $?.success?

  out.lines.map(&:split).select { |name, path| name.to_s.match?(/\A\h{64}\z/) && path == REGISTRY_DATA }.map(&:first)
rescue Errno::ENOENT # no docker on the PATH: no registry either, and its removal below still runs
  []
end

kamal("version") || refuse("kamal is not installed (the pinned global gem, see the runbook).")
kamal("server", "exec", "-d", DESTINATION, put_proxy) ||
  refuse("the pinned kamal-proxy could not be put on the host by its digest; see kamal's output above (threat model SR-27).")

deployed = false
begin
  deployed = kamal("setup", "-d", DESTINATION)
ensure
  volumes = registry_volumes
  if kamal("registry", "remove", "-d", DESTINATION)
    volumes.each do |volume|
      next if system("docker", "volume", "rm", volume, out: File::NULL)

      warn "bin/deploy: the local registry's volume could not be removed; run `docker volume rm #{volume}`."
    end
  else
    volume_step = volumes.any? ? ", then `docker volume rm #{volumes.join(" ")}`" : ""
    warn "bin/deploy: the local registry could not be removed; run `kamal registry remove -d #{DESTINATION}`#{volume_step}."
  end
end

refuse "kamal setup failed; see its output above." unless deployed
