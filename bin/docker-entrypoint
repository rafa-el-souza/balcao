#!/usr/bin/env ruby
# The container's entrypoint: the generator's shell script, rewritten in Ruby
# because no shell script lives in the repository (design NFR-08, §6.9). When
# the command starts the web server (./bin/rails server, directly or behind
# Thruster), the databases are created or migrated first and the app's own
# database role made and granted (DatabaseRole), both as the database's owner
# (DATABASE_OWNER=1, config/database.yml); any other command, such as the job
# container's bin/jobs, runs as given.
#
# Every command then connects as the app's role, without the owner's password:
# it leaves the environment the command starts with, so a process the app was
# made to run cannot read it there (threat model SR-24; M3-4, #4's review).

abort "docker-entrypoint: no command to run" if ARGV.empty?

if ARGV.last(2) == [ "./bin/rails", "server" ]
  system({ "DATABASE_OWNER" => "1" }, "./bin/rails", "db:prepare", "db:app_role") ||
    abort("docker-entrypoint: bin/rails db:prepare db:app_role failed; the server was not started.")
end

ENV.delete("POSTGRES_PASSWORD")
ENV.delete("DATABASE_OWNER")
exec(*ARGV)
