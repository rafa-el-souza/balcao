# The environment of the production image, by name only (design §8, threat
# model SR-25). Values live in each destination's env file, outside the
# repository, and reach the containers through Kamal: .kamal/secrets for
# production, .kamal/secrets.ensaio for the rehearsal. Development and the
# test suite need none of them; bin/evals, run by hand, reads the model key.

# Generated per destination: bin/secrets-example prints a fresh set.
SECRET_KEY_BASE=
POSTGRES_PASSWORD=
APP_DATABASE_PASSWORD=
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
IDENTITY_PEPPER=
TELEGRAM_WEBHOOK_SECRET=

# Clear settings, written in config/deploy.yml and config/deploy.ensaio.yml.
# MODEL_ADAPTER is real on the public name; fake, the replies the evals
# recorded, is a rehearsal host's default from the cut (design §8), refused
# on the public name. BUDGET_CAP_USD is the month's model spend, in US
# dollars, at which the demo pauses (FR-14).
APP_HOST=
DB_HOST=
MODEL_ADAPTER=
BUDGET_CAP_USD=

# Held by the model provider's console, never generated: on the MVP host the
# spend-limited dev/eval key (design §8, §6.4). Blank beside the fake model,
# which reads none: the boot refuses a key there.
ANTHROPIC_API_KEY=
# Held by BotFather, never generated: the demo bot's token (FR-19, design §8).
TELEGRAM_BOT_TOKEN=
# Held by Cloudflare's dashboard, never generated: the Turnstile widget's
# secret on the public name, Cloudflare's published test secret on a rehearsal
# host (threat model SR-39, ADR-0012); the site key is public and lives in the
# web app.
TURNSTILE_SECRET_KEY=
# Held by the external monitor's console, never generated: the canary's
# heartbeat URL and the Telegram delivery watch's, each with the monitor's
# token in it (FR-17, NFR-04). Required on the public name, blank on a
# rehearsal host (design §8).
MONITOR_URL=
TELEGRAM_MONITOR_URL=

# A clear setting the boot holds to the name (design §8, M3-6b): true off the
# public name, where every answer then says X-Robots-Tag: noindex, and blank
# on it. Set in config/deploy.ensaio.yml from the cut; production leaves it out.
NOINDEX=

# Read by config/deploy.ensaio.yml from the deploying shell, for bin/deploy.
ENSAIO_HOST=
ENSAIO_SSH_KEY=
ENSAIO_SSH_CONFIG=
