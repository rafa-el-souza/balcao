# The environment of the production image, by name only (design §8, threat
# model SR-25). Values live in each destination's env file, outside the
# repository, and reach the containers through Kamal: .kamal/secrets for
# production, .kamal/secrets.ensaio for the rehearsal. Development and the
# test suite need none of them; bin/evals, run by hand, reads the model key.

# Generated per destination: bin/secrets-example prints a fresh set.
SECRET_KEY_BASE=
POSTGRES_PASSWORD=
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
IDENTITY_PEPPER=
TELEGRAM_WEBHOOK_SECRET=

# Clear settings, written in config/deploy.yml and config/deploy.ensaio.yml.
# MODEL_ADAPTER is real until M3 brings the fake one for rehearsal hosts.
# BUDGET_CAP_USD is the month's model spend, in US dollars, at which the demo
# pauses (FR-14).
APP_HOST=
DB_HOST=
MODEL_ADAPTER=
BUDGET_CAP_USD=

# Held by the model provider's console, never generated: on the MVP host the
# spend-limited dev/eval key (design §8, §6.4).
ANTHROPIC_API_KEY=
# Held by BotFather, never generated: the demo bot's token (FR-19, design §8).
TELEGRAM_BOT_TOKEN=
# Held by Cloudflare's dashboard, never generated: the Turnstile widget's
# secret on the public name, Cloudflare's published test secret on a rehearsal
# host (threat model SR-39, ADR-0012); the site key is public and lives in the
# web app.
TURNSTILE_SECRET_KEY=

# Named ahead of the slices that read them. With its slice, a secret joins the
# boot check (config/required_environment.rb), both .kamal/secrets files and
# env.secret in config/deploy.yml; a clear setting joins env.clear.
# true on rehearsal hosts, from M3: X-Robots-Tag noindex (design §8).
NOINDEX=
# The external monitor's URL that the canary pings, from M3 (FR-17, design §8).
MONITOR_URL=

# Read by config/deploy.ensaio.yml from the deploying shell, for bin/deploy.
ENSAIO_HOST=
ENSAIO_SSH_KEY=
ENSAIO_SSH_CONFIG=
