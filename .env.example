# The environment of the production image, by name only (design §8, threat
# model SR-25). Values live in each destination's env file, outside the
# repository, and reach the containers through Kamal: .kamal/secrets for
# production, .kamal/secrets.ensaio for the rehearsal. Development and the
# test suite need none of them; bin/evals, run by hand, reads the model key.

# Generated per destination: bin/secrets-example prints a fresh set.
SECRET_KEY_BASE=
POSTGRES_PASSWORD=
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
IDENTITY_PEPPER=

# Clear settings, written in config/deploy.yml and config/deploy.ensaio.yml.
APP_HOST=
DB_HOST=

# Named ahead of the slices that read them. With its slice, a secret joins the
# boot check (config/required_environment.rb), both .kamal/secrets files and
# env.secret in config/deploy.yml; a clear setting joins env.clear.
# The model adapter, real or fake, and the model key: on the MVP host the
# spend-limited dev/eval key (design §8, §6.4).
MODEL_ADAPTER=
ANTHROPIC_API_KEY=
# WhatsApp Cloud API, from day 11 (FR-19, threat model SR-06, SR-08). The phone
# number id and the WABA id are not secret; the other three are.
META_APP_SECRET=
META_ACCESS_TOKEN=
META_VERIFY_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
# Cloudflare Turnstile's secret key, from the first slice after the MVP
# (threat model SR-39); the site key is public and lives in the web app.
TURNSTILE_SECRET_KEY=
# true on rehearsal hosts, from M3: X-Robots-Tag noindex (design §8).
NOINDEX=

# Read by config/deploy.ensaio.yml from the deploying shell, for bin/deploy.
ENSAIO_HOST=
ENSAIO_SSH_KEY=
ENSAIO_SSH_CONFIG=
