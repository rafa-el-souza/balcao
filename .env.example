# The environment of the production image, by name only (design §8, threat
# model SR-25). Values live in each destination's env file, outside the
# repository, and reach the containers through Kamal: .kamal/secrets for
# production, .kamal/secrets.ensaio for the rehearsal. Development and the
# test suite need none of them.

# Generated per destination: bin/secrets-example prints a fresh set.
SECRET_KEY_BASE=
POSTGRES_PASSWORD=
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
IDENTITY_PEPPER=

# Clear settings, written in config/deploy.yml and config/deploy.ensaio.yml.
APP_HOST=
DB_HOST=

# Read by config/deploy.ensaio.yml from the deploying shell, for bin/deploy.
ENSAIO_HOST=
ENSAIO_SSH_KEY=
ENSAIO_SSH_CONFIG=
