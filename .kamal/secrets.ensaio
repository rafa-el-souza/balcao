# The rehearsal destination: references only (threat model SR-25). Kamal
# resolves each one from the development account's environment, loaded from
# its rehearsal env file; bin/secrets-example generates the values. With -d
# ensaio, Kamal reads this file and never .kamal/secrets.
SECRET_KEY_BASE=$SECRET_KEY_BASE
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
ANTHROPIC_API_KEY=$ANTHROPIC_API_KEY
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=$ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=$ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=$ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT
IDENTITY_PEPPER=$IDENTITY_PEPPER
TELEGRAM_BOT_TOKEN=$TELEGRAM_BOT_TOKEN
TELEGRAM_WEBHOOK_SECRET=$TELEGRAM_WEBHOOK_SECRET
