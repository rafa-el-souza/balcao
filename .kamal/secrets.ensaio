# The rehearsal destination: references only (threat model SR-25). Kamal
# resolves each one from the development account's environment, loaded from
# its rehearsal env file; bin/secrets-example generates the values. With -d
# ensaio, Kamal reads this file and never .kamal/secrets.
SECRET_KEY_BASE=$SECRET_KEY_BASE
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
ANTHROPIC_API_KEY=$ANTHROPIC_API_KEY
