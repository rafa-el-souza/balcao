# Session artefacts, not product documentation (ADR-0007)
IMPLEMENTATION-BRIEF.md

# Secrets — never in the repo (threat model SR-25).
# .kamal/secrets and .kamal/secrets.ensaio are tracked: references only (VAR=$VAR).
.env
.env.*
!.env.example
config/master.key
config/credentials/*.key
/config/*.key

# Bundler config
/.bundle

# Local state (Rails keeps the directories through their .keep files)
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep
storage/
db/*.sqlite3*
coverage/
node_modules/
web/dist/
web/test-results/
web/playwright-report/
public/vite/
public/assets/

# Eval raw runs stay local; the scorecard and the recordings are committed
evals/results/

# Claude Code local settings (the tracked agents live in .claude/agents/)
.claude/settings.local.json

# Editors, tools and OS
.ruby-lsp/
.DS_Store
.idea/
.vscode/
*.swp

# Owner's private files (hand list, CLAUDE.md, voice, settings, handoff):
# beside the spec, never tracked (ADR-0007)
OWNER-*

# The operator checkout's record of the last production deploy (docs/runbook.md,
# threat model SR-38): kept beside the checkout, never committed.
/.last-deployed-sha
